# Environment Configuration

# Application
APP_NAME=CommonGround
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/commonground

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API (for ARIA fallback)
OPENAI_API_KEY=your-openai-api-key

# Daily.co (Video Calling for KidComs)
DAILY_API_KEY=your-daily-api-key
DAILY_DOMAIN=cg-mvp.daily.co

# Mux (KidSpace theater streaming)
# Create a full-access video token at Mux dashboard → Settings → Access Tokens.
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-secret  # optional — for asset.ready webhooks

# Mapbox (Silent Handoff geofencing — Wave 1)
# Use a PUBLIC token (pk.*). Never paste a secret token (sk.*) here.
# Paste the same value as NEXT_PUBLIC_MAPBOX_TOKEN on the frontend.
MAPBOX_API_KEY=pk.your-public-mapbox-token

# Redis (for caching and real-time)
REDIS_URL=redis://localhost:6379

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Storage
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# Email (SendGrid)
EMAIL_ENABLED=false
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@commonground.family
FROM_NAME=CommonGround

# Monitoring
SENTRY_DSN=your-sentry-dsn-here

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds
