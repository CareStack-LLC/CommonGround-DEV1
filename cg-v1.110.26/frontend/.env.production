# CommonGround Frontend - Production Environment
# These values are used when building for production

# API Configuration
# Custom domain fronting the live us-east backend (commonground-api-east).
# The previous service (commonground-api-a0fr) was suspended.
# NOTE: production also sets these in the Vercel dashboard, which overrides
# this file — keep them in sync there too.
NEXT_PUBLIC_API_URL=https://api.find-commonground.com
NEXT_PUBLIC_WS_URL=wss://api.find-commonground.com

# App Configuration
NEXT_PUBLIC_APP_NAME=CommonGround
NEXT_PUBLIC_APP_URL=https://common-ground-blue.vercel.app

# Mapbox (for Silent Handoff geofence maps)
# Set NEXT_PUBLIC_MAPBOX_TOKEN in your deployment environment (Vercel, etc.)
