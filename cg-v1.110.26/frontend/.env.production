# CommonGround Frontend - Production Environment
# These values are used when building for production

# API Configuration
# Points at the us-east backend (commonground-api-east). The previous
# service (commonground-api-a0fr) was suspended.
NEXT_PUBLIC_API_URL=https://commonground-api-east.onrender.com
NEXT_PUBLIC_WS_URL=wss://commonground-api-east.onrender.com

# App Configuration
NEXT_PUBLIC_APP_NAME=CommonGround
NEXT_PUBLIC_APP_URL=https://common-ground-blue.vercel.app

# Mapbox (for Silent Handoff geofence maps)
# Set NEXT_PUBLIC_MAPBOX_TOKEN in your deployment environment (Vercel, etc.)
